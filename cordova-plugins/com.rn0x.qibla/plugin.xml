<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://apache.org/cordova/ns/plugins/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android"
        id="com.rn0x.qibla"
        version="1.0.0">
    <name>QiblaSensor</name>
    <description>Tilt-compensated compass azimuth stream for the Qibla screen (Android)</description>
    <license>MIT</license>
    <keywords>cordova, compass, sensor, azimuth, rotation-vector, qibla, android</keywords>
    <author>rn0x</author>

    <js-module src="www/qibla.js" name="QiblaSensor">
        <clobbers target="cordova.plugins.QiblaSensor" />
    </js-module>

    <platform name="android">
        <config-file target="res/xml/config.xml" parent="/*">
            <feature name="QiblaSensor">
                <param name="android-package" value="com.rn0x.qibla.QiblaSensor" />
                <param name="onload" value="true" />
            </feature>
        </config-file>

        <config-file target="AndroidManifest.xml" parent="/*">
            <!-- A magnetometer is optional (the app degrades to a static bearing) -->
            <uses-feature android:name="android.hardware.sensor.compass" android:required="false" />
        </config-file>

        <source-file src="src/android/com/rn0x/qibla/QiblaSensor.java" target-dir="src/com/rn0x/qibla" />
    </platform>
</plugin>