AutoName: التقوى
Summary: تطبيق إسلامي مجاني ومفتوح المصدر
Description: |-
  تطبيق «التقوى» — رفيق المسلم اليومي:
  المصحف، التفسير الميسر، مواقيت الصلاة، اتجاه القبلة،
  الأذكار وحصن المسلم، المسبحة الإلكترونية، راديو التقوى،
  الموسوعة التاريخية، فتاوى ابن باز، الخطب، وأنشطة تفاعلية.
  مجاني بالكامل دون إعلانات أو تتبع، ويعمل دون إنترنت للمحتوى المرفق.
  .

RepoType: git
Repo: https://github.com/rn0x/altaqwaa-android.git

Builds:
  - versionName: 3.0.1
    versionCode: 30001
    commit: v3.0.1-fdroid
    subdir: .
    sudo:
      - apt-get update
      - apt-get install -y cmake ninja-build openjdk-21-jdk-headless python3 python3-pil
      - curl -Lo node.tar.gz https://nodejs.org/dist/v22.22.2/node-v22.22.2-linux-x64.tar.gz
      - echo "978978a635eef872fa68beae09f0aad0bbbae6757e444da80b570964a97e62a3  node.tar.gz"
        | sha256sum -c -
      - tar xzf node.tar.gz --strip-components=1 -C /usr/local/
      - rm node.tar.gz
      - npm install -g npm@11.2.0
    init: echo "source prepared"
    output: platforms/android/app/build/outputs/apk/release/app-release-unsigned.apk
    build:
      - npm ci
      - sdkmanager 'platforms;android-36' 'build-tools;36.0.0'
      - bash scripts/fdroid-build.sh
    ndk: 27.1.12297006

MaintainerNotes: |-
  Native STT engine is vendored from handy-computer/transcribe.cpp v0.2.0
  (MIT) under cordova-plugins/.../native/ and compiled with NDK 27 at build
  time. The prebuilt .so are gitignored and never committed; libs/ is
  generated by scripts/fdroid-build.sh. Model moonshine-tiny-ar-Q8_0.gguf is
  CC-BY data. Builds require Node 20, JDK 21, Android SDK with NDK r27,
  CMake and Ninja.
  .

AutoUpdateMode: None
UpdateCheckMode: None
CurrentVersion: 3.0.1
CurrentVersionCode: 30001
