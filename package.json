    "com.rn0x.prayerlocation": "file:cordova-plugins/com.rn0x.prayerlocation",
    "com.rn0x.prayerwatch": "file:cordova-plugins/com.rn0x.prayerwatch",
    "com.rn0x.systemui": "file:cordova-plugins/system-ui",
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-plugin-compat": "^1.2.0",
    "cordova-plugin-device": "^3.0.0",
    "cordova-plugin-file": "^4.3.3",
    "cordova-plugin-file-opener2": "^4.0.0",
    "cordova-plugin-inappbrowser": "^4.1.0",
    "cordova-plugin-local-notification": "^1.2.3",
    "vite": "^7.3.6"
  },
  "cordova": {
    "platforms": [
